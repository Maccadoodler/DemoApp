		{
			"name": "Average",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the response body to JSON\r",
							"const responseBody = pm.response.json();\r",
							"\r",
							"// Test to check if the 'task' value is present and is a string\r",
							"pm.test('Task value should exist and be a string', () => {\r",
							"    pm.expect(responseBody.task).to.exist;\r",
							"    pm.expect(responseBody.task).to.be.a('string');\r",
							"});\r",
							"\r",
							"// Test to check the actual value of the 'task'\r",
							"pm.test('The actual value of the task should be \"John\"', () => {\r",
							"    pm.expect(responseBody.task).to.equal('John');\r",
							"});\r",
							"\r",
							"// Test to check the actual value of the 'average'\r",
							"pm.test('The actual value of the average should be 20', () => {\r",
							"    pm.expect(responseBody.average).to.equal(20);\r",
							"});\r",
							"\r",
							"// Test to check if the 'average' value is present and is a number\r",
							"pm.test('average value should exist and be a number', () => {\r",
							"    pm.expect(responseBody.average).to.exist;\r",
							"    pm.expect(responseBody.average).to.be.a('number');\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
